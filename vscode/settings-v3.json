{
  // #################################
  // ###########  GENERAL ############
  // #################################
  "security.workspace.trust.untrustedFiles": "open",
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "npm.fetchOnlinePackageInfo": false,

  // #################################
  // #####  WORKBENCH / UI LAYOUT ####
  // #################################
  "workbench.startupEditor": "none",
  "workbench.iconTheme": "file-icons-colourless",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.colorTheme": "j_blow",
  "workbench.preferredDarkColorTheme": "j_blow",
  "workbench.layoutControl.enabled": false,
  "workbench.settings.applyToAllProfiles": ["workbench.colorCustomizations"],
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.sideBar.location": "left",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.navigationControl.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.browser.showInTitleBar": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "breadcrumbs.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.editorAssociations": {
    "*.svg": "default"
  },

  // #################################
  // #######  WINDOW SETTINGS  #######
  // #################################
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.restoreWindows": "one",
  "window.newWindowDimensions": "maximized",
  "window.nativeTabs": false,
  "window.density.editorTabHeight": "compact",

  // #################################
  // #####  FILE EXPLORER SETTINGS ###
  // #################################
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 1,

  // #################################
  // #######  EDITOR APPEARANCE ######
  // #################################
  "editor.fontFamily": "Iosevka",
  "editor.fontSize": 16,
  "editor.glyphMargin": false,
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.hideCursorInOverviewRuler": true,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "solid",
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.codeLens": false,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "keyword.other.dotenv",
        "settings": {
          "foreground": "#FF000000"
        }
      }
    ]
  },
  "custom-ui-style.font.monospace": "\"Iosevka\"",
  "custom-ui-style.font.sansSerif": "\"Iosevka\"",
  "custom-ui-style.font.serif": "\"Iosevka\"",

  // #################################
  // ########  EDITOR BEHAVIOR #######
  // #################################
  "editor.accessibilitySupport": "off",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 150,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.inlineSuggest.enabled": false,

  // #################################
  // ###########  FILES ##############
  // #################################
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true
  },
  "search.searchOnType": false,

  // #################################
  // ###########  TERMINAL ###########
  // #################################
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.tabs.enabled": false,

  // ##########################
  // ######### VIM ############
  // ##########################
  "vim.leader": "<space>",
  "vim.foldfix": true,
  "vim.smartRelativeLine": true,
  "vim.argumentObjectClosingDelimiters": [],
  "vim.argumentObjectOpeningDelimiters": [],
  "vim.highlightedyank.duration": 1,
  "vim.mouseSelectionGoesIntoVisualMode": false,
  "vim.useSystemClipboard": true,
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.sneak": true,
  "vim.normalModeKeyBindings": [
    {
      "before": ["<leader>", "d"],
      "after": ["d", "d"]
    },
    {
      "before": ["<tab>"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<S-tab>"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "f", "w"],
      "commands": ["workbench.action.findInFiles"]
    }
  ],
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    },
    {
      "before": ["<C-j>"],
      "after": ["<Esc>"]
    },
    {
      "before": ["<C-k>"],
      "after": ["<Esc>"]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "after": [">", "g", "v"]
    },
    {
      "before": ["<"],
      "after": ["<", "g", "v"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "d"],
      "after": ["d", "d"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.splitEditor"]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    {
      "before": ["<leader>", "f"],
      "commands": ["revealInExplorer"]
    },
    {
      "before": ["<leader>", "h"],
      "after": ["_"]
    },
    {
      "before": ["<leader>", "l"],
      "after": ["$"]
    },
    {
      "before": ["<leader>", "H"],
      "commands": [
        {
          "command": "editor.action.showDefinitionPreviewHover"
        }
      ]
    },
    {
      "before": ["j"],
      "after": ["g", "j"]
    },
    {
      "before": ["k"],
      "after": ["g", "k"]
    }
  ],
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    // VS Code new marker @ next occurence
    "<C-c>": false,
    // Cut
    "<C-x>": false,
    // Paste
    "<C-v>": false,
    "<C-z>": false,
    "<C-y>": false
  },

  // ############################
  // ## APC EXTENSION SETTINGS ##
  // ############################
  "apc.electron": {
    "frame": false,
    "trafficLightPosition": {
      "x": -500,
      "y": 0
    },
    "window.customTitleBarVisibility": "never",
    "apc.menubar.compact": true,
    "backgroundColor": "rgba(123, 123, 123, 0.5)",
    "titleBarStyle": "hiddenInset",
    "vibrancy": "ultra-dark",
    "opacity": 0.95,
    "visualEffectState": "active"
  },
  "apc.statusBar": {
    "fontSize": 10,
    "height": 18
  },
  "apc.header": {
    "height": 18
  },

  // ###########################################
  // #######  LANGUAGE SUPPORT SETTINGS ########
  // ###########################################
  "[prisma]": {
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[svelte]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "svelte.enable-ts-plugin": true,
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["cnva\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "biome.suggestInstallingGlobally": false,
  "cmake.options.statusBarVisibility": "compact",
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  "makefile.configureOnOpen": true,

  // #################################
  // ###########  GIT ################
  // #################################
  "gitlens.advanced.messages": {
    "suppressIntegrationRequestTimedOutWarning": true
  },

  // ################################
  // ########### OBSIDIAN ###########
  // ################################
  "obsidian-md-vsc.defaultVault": "second-brain",
  "obsidian-md-vsc.defaultVaultPath": "/Users/jgomes/repos/github/j5gomes/second-brain",
  "obsidian-md-vsc.defaultNote": "0-inbox/inbox",

  // ################################
  // ##### DISABLE AI FEATURES ######
  // ################################
  "chat.commandCenter.enabled": false,
  "chat.agent.enabled": false,
  "chat.detectParticipant.enabled": false,
  "chat.agentsControl.enabled": "hidden",
  "chat.checkpoints.enabled": false,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false,
  "gitlens.ai.enabled": false,

  // ################################
  // #####  TASK BUTTONS ############
  // ################################
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "sb",
      "task": "storybook",
      "tooltip": "Run Storybook",
      "alignment": "right",
      "color": "warning"
    },
    {
      "label": "run dev",
      "task": "dev",
      "tooltip": "Run Dev Server",
      "alignment": "right",
      "color": "error"
    }
  ]
}
